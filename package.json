{
  "name": "manabo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/restore-media.mjs",
    "build": "vite build && node previews/starpath/scripts/build.mjs && python3 scripts/publish-starpath.py && node scripts/check-media.mjs",
    "preview": "vite preview",
    "prepreview:study": "npm run build",
    "preview:study": "python3 previews/starpath/preview.py",
    "sync-data": "node scripts/sync-sheets.mjs",
    "sync-media": "node scripts/sync-media.mjs",
    "media:restore": "node scripts/restore-media.mjs",
    "media:check": "node scripts/check-media.mjs",
    "release:assets": "node scripts/release-assets.mjs && npm run media:check",
    "deploy": "npm run build && npm run release:assets && wrangler deploy",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "test:browser:production": "playwright test --config=playwright.production.config.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-xml-parser": "5.12.0",
    "sharp": "0.35.5",
    "vite": "^8.3.6",
    "wrangler": "4.158.0"
  }
}
