{
  "name": "manabo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/restore-media.mjs",
    "build": "vite build && node scripts/check-media.mjs",
    "preview": "vite preview",
    "sync-data": "node scripts/sync-sheets.mjs",
    "sync-media": "node scripts/sync-media.mjs",
    "media:restore": "node scripts/restore-media.mjs",
    "media:check": "node scripts/check-media.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "fast-xml-parser": "5.12.0",
    "sharp": "0.35.5",
    "vite": "^8.3.6",
    "wrangler": "4.158.0"
  }
}
